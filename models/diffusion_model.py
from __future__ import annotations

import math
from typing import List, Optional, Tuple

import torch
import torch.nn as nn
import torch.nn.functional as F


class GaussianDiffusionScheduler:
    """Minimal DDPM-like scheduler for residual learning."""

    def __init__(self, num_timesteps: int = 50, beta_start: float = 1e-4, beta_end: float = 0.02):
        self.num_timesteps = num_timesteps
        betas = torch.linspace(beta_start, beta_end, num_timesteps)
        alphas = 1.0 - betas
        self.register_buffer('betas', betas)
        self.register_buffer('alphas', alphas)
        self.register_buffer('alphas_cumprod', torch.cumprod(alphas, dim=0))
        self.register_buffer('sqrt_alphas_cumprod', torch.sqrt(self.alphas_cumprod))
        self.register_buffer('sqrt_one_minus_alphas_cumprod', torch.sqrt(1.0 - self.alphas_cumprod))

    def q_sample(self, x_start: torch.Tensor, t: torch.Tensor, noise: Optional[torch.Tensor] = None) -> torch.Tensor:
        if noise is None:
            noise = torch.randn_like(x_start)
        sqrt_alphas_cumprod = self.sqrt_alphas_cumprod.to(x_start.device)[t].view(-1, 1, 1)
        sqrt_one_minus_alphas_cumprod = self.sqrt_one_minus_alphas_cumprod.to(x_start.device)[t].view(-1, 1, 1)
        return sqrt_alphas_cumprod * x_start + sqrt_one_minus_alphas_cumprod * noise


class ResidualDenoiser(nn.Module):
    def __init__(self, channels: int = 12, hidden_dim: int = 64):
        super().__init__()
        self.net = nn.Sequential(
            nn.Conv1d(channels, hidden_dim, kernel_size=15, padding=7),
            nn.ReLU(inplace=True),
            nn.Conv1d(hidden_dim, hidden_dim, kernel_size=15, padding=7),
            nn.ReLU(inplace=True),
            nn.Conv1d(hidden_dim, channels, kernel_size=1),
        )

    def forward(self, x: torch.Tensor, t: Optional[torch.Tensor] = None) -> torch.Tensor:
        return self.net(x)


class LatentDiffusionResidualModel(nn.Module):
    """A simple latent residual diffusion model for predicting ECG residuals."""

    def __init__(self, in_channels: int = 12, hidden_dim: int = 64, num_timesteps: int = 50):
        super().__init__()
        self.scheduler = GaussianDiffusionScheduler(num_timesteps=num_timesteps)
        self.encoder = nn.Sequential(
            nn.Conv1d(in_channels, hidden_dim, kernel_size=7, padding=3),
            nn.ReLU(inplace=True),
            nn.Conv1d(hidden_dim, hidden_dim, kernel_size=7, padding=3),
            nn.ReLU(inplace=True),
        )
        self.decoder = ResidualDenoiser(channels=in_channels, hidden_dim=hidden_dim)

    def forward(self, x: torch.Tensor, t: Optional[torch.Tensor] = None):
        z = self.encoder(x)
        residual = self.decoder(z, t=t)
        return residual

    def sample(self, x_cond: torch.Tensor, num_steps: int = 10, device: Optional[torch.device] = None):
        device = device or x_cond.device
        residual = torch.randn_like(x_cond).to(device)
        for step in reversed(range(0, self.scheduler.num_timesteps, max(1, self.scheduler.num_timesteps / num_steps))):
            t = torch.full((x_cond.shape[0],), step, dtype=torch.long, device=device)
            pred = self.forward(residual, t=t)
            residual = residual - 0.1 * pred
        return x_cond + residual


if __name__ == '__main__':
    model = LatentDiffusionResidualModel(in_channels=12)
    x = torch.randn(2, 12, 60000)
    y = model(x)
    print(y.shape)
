from __future__ import annotations

import torch
import torch.nn as nn
import torch.nn.functional as F


class ResidualBlock1D(nn.Module):
    def __init__(self, channels: int, kernel_size: int = 15, dilation: int = 1):
        super().__init__()
        padding = (kernel_size - 1) // 2 * dilation
        self.conv1 = nn.Conv1d(channels, channels, kernel_size, padding=padding, dilation=dilation)
        self.bn1 = nn.BatchNorm1d(channels)
        self.act1 = nn.ReLU(inplace=True)
        self.conv2 = nn.Conv1d(channels, channels, kernel_size, padding=padding, dilation=dilation)
        self.bn2 = nn.BatchNorm1d(channels)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        residual = x
        out = self.conv1(x)
        out = self.bn1(out)
        out = self.act1(out)
        out = self.conv2(out)
        out = self.bn2(out)
        return out + residual


class MultiScaleECGReconstructionNet(nn.Module):
    """Baseline deterministic model for low-lead to 12-lead ECG reconstruction."""

    def __init__(self, in_channels: int = 1, out_channels: int = 12, base_channels: int = 32):
        super().__init__()
        self.in_channels = in_channels
        self.out_channels = out_channels
        self.base_channels = base_channels

        self.input_proj = nn.Conv1d(in_channels, base_channels, kernel_size=7, padding=3)

        self.encoder1 = nn.Sequential(
            ResidualBlock1D(base_channels, kernel_size=9),
            ResidualBlock1D(base_channels, kernel_size=9),
            nn.MaxPool1d(2),
        )
        self.encoder2 = nn.Sequential(
            ResidualBlock1D(base_channels * 2, kernel_size=11),
            ResidualBlock1D(base_channels * 2, kernel_size=11),
            nn.MaxPool1d(2),
        )

        self.mid = nn.Sequential(
            nn.Conv1d(base_channels * 2, base_channels * 4, kernel_size=9, padding=4),
            nn.BatchNorm1d(base_channels * 4),
            nn.ReLU(inplace=True),
            ResidualBlock1D(base_channels * 4, kernel_size=15),
            ResidualBlock1D(base_channels * 4, kernel_size=15),
        )

        self.decoder2 = nn.Sequential(
            nn.ConvTranspose1d(base_channels * 4, base_channels * 2, kernel_size=4, stride=2, padding=1),
            nn.BatchNorm1d(base_channels * 2),
            nn.ReLU(inplace=True),
            ResidualBlock1D(base_channels * 2, kernel_size=11),
        )

        self.decoder1 = nn.Sequential(
            nn.ConvTranspose1d(base_channels * 2, base_channels, kernel_size=4, stride=2, padding=1),
            nn.BatchNorm1d(base_channels),
            nn.ReLU(inplace=True),
            ResidualBlock1D(base_channels, kernel_size=9),
            ResidualBlock1D(base_channels, kernel_size=9),
        )

        self.output_head = nn.Sequential(
            nn.Conv1d(base_channels, out_channels, kernel_size=1),
        )

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.input_proj(x)

        e1 = self.encoder1(x)
        e2 = self.encoder2(e1)
        m = self.mid(e2)
        d2 = self.decoder2(m)
        if d2.shape[-1] != e1.shape[-1]:
            d2 = F.interpolate(d2, size=e1.shape[-1], mode='linear', align_corners=False)
        d1 = self.decoder1(d2)
        out = self.output_head(d1)
        return out


if __name__ == '__main__':
    model = MultiScaleECGReconstructionNet(in_channels=1, out_channels=12)
    x = torch.randn(2, 1, 60000)
    y = model(x)
    print(y.shape)
